generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPERADMIN
  COMPANY_ADMIN
  EMPLOYEE
}

enum AttendanceType {
  ENTRY
  EXIT
  BREAK_START
  BREAK_END
  MEAL_START
  MEAL_END
}

enum AttendanceAuditOperation {
  INSERT
  UPDATE
  DELETE
}

enum PayrollPeriodStatus {
  OPEN
  APPROVED
  LOCKED
}

enum DevicePurpose {
  ENTRY
  EXIT
  BREAK_START
  BREAK_END
  BIDIRECTIONAL
}

enum FirmwareDeploymentStatus {
  PENDING
  DOWNLOADING
  INSTALLED
  FAILED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  EXCUSE
  UNPAID
  MEDICAL
  ADMINISTRATIVE
  HOURLY
  HALF_DAY
}

enum LeaveDurationType {
  FULL_DAY
  HALF_DAY
  HOURLY
}

enum LeaveApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkDayType {
  NORMAL_WORK
  WEEKLY_REST
  NON_WORKING
  OFFICIAL_HOLIDAY
  COMPANY_HOLIDAY
  HALF_WORK
  EXTRA_WORK
  SPECIAL_WORK
  LEAVE
  CONFLICT
}

enum CalendarScopeType {
  COMPANY
  BRANCH
  DEPARTMENT
  EMPLOYEE
}

enum SpecialDayType {
  OFFICIAL_HOLIDAY
  COMPANY_HOLIDAY
  ADMINISTRATIVE_HOLIDAY
  HALF_WORK
  EXTRA_WORK
  DEPARTMENT_HOLIDAY
  DEPARTMENT_WORK
  BRANCH_HOLIDAY
  BRANCH_WORK
}

enum CalendarCalculationStatus {
  CALCULATED
  CONFLICT
  MISSING_DEFAULT
  OUT_OF_EMPLOYMENT
}

enum EmploymentStatus {
  ACTIVE
  PASSIVE
  BEFORE_HIRE
  AFTER_TERMINATION
}

enum CalendarRecordType {
  TEMPLATE
  WEEKDAY
  ASSIGNMENT
  SPECIAL_DAY
  DAILY_EXCEPTION
  EMPLOYEE_DAILY_CALENDAR
}

enum CalendarApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CompanyMembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum DataScopeMode {
  COMPANY
  RESTRICTED
  OWN
  NONE
}

enum CompanyInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Company {
  id                  Int                      @id @default(autoincrement()) @db.UnsignedInt
  name                String
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  address             String?
  city                String?
  district            String?
  category            String?
  isActive            Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  users               User[]
  userAccess          UserCompanyAccess[]
  employees           Employee[]
  devices             Device[]
  departments         Department[]
  branches            Branch[]
  managers            Manager[]
  calendarTemplates   WorkCalendarTemplate[]
  calendarAssignments CalendarAssignment[]
  calendarSpecialDays CalendarSpecialDay[]
  dailyExceptions     CalendarDailyException[]
  payrollPeriods      PayrollPeriod[]
  companyRoles        CompanyRole[]
  memberships         CompanyMembership[]
  invitations         CompanyInvitation[]
  accessAudits        CompanyAccessAudit[]
  teams               CompanyTeam[]
}

model CompanyCategory {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoleDefinition {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  code        Role     @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                          Int                          @id @default(autoincrement()) @db.UnsignedInt
  username                    String?                      @unique @db.VarChar(64)
  email                       String                       @unique
  phone                       String?                      @db.VarChar(32)
  password                    String
  name                        String?
  firstName                   String?
  lastName                    String?
  tcNo                        String?
  role                        Role                         @default(COMPANY_ADMIN)
  companyId                   Int?                         @db.UnsignedInt
  company                     Company?                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyAccess               UserCompanyAccess[]
  deviceAccess                UserDeviceAccess[]
  attendanceAudits            AttendanceMovementAudit[]
  firmwareReleases            FirmwareRelease[]
  firmwareDeployments         FirmwareDeployment[]
  attendanceReviewResolutions AttendanceReviewResolution[]
  approvedPayrollPeriods      PayrollPeriod[]              @relation("PayrollApprovedBy")
  lockedPayrollPeriods        PayrollPeriod[]              @relation("PayrollLockedBy")
  memberships                 CompanyMembership[]
  sentCompanyInvitations      CompanyInvitation[]          @relation("InvitationCreatedBy")
  accessAuditActions          CompanyAccessAudit[]         @relation("AccessAuditActor")
  accessAuditTargets          CompanyAccessAudit[]         @relation("AccessAuditTarget")
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
}

model UserCompanyAccess {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  userId    Int      @db.UnsignedInt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId Int      @db.UnsignedInt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
}

model CompanyRole {
  id          Int                     @id @default(autoincrement()) @db.UnsignedInt
  companyId   Int                     @db.UnsignedInt
  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key         String                  @db.VarChar(64)
  name        String
  description String?                 @db.Text
  isSystem    Boolean                 @default(false)
  isActive    Boolean                 @default(true)
  permissions CompanyRolePermission[]
  memberships CompanyMembership[]
  invitations CompanyInvitation[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([companyId, key])
}

model CompanyRolePermission {
  id         Int         @id @default(autoincrement()) @db.UnsignedInt
  roleId     Int         @db.UnsignedInt
  role       CompanyRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String      @db.VarChar(96)

  @@unique([roleId, permission])
}

model CompanyMembership {
  id               Int                         @id @default(autoincrement()) @db.UnsignedInt
  userId           Int                         @db.UnsignedInt
  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId        Int                         @db.UnsignedInt
  company          Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleId           Int                         @db.UnsignedInt
  role             CompanyRole                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  employeeId       Int?                        @unique @db.UnsignedInt
  employee         Employee?                   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  status           CompanyMembershipStatus     @default(PENDING)
  scopeMode        DataScopeMode               @default(NONE)
  sessionVersion   Int                         @default(1) @db.UnsignedInt
  branchScopes     MembershipBranchScope[]
  departmentScopes MembershipDepartmentScope[]
  employeeScopes   MembershipEmployeeScope[]
  deviceScopes     MembershipDeviceScope[]
  teamScopes       MembershipTeamScope[]
  modules          MembershipModule[]
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@unique([userId, companyId])
  @@index([companyId, status])
}

model MembershipModule {
  membershipId Int               @db.UnsignedInt
  membership   CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  moduleKey    String            @db.VarChar(64)
  createdAt    DateTime          @default(now())

  @@id([membershipId, moduleKey])
  @@index([moduleKey])
}

model MembershipBranchScope {
  membershipId Int               @db.UnsignedInt
  membership   CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branchId     Int               @db.UnsignedInt
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([membershipId, branchId])
}

model MembershipDepartmentScope {
  membershipId Int               @db.UnsignedInt
  membership   CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  departmentId Int               @db.UnsignedInt
  department   Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([membershipId, departmentId])
}

model MembershipEmployeeScope {
  membershipId Int               @db.UnsignedInt
  membership   CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  employeeId   Int               @db.UnsignedInt
  employee     Employee          @relation("ExplicitEmployeeScope", fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([membershipId, employeeId])
}

model MembershipDeviceScope {
  membershipId Int               @db.UnsignedInt
  membership   CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  deviceId     Int               @db.UnsignedInt
  device       Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([membershipId, deviceId])
}

model MembershipTeamScope {
  membershipId Int               @db.UnsignedInt
  membership   CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  teamId       Int               @db.UnsignedInt
  team         CompanyTeam       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([membershipId, teamId])
}

model CompanyTeam {
  id        Int                   @id @default(autoincrement()) @db.UnsignedInt
  companyId Int                   @db.UnsignedInt
  company   Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean               @default(true)
  members   CompanyTeamEmployee[]
  scopes    MembershipTeamScope[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([companyId, name])
}

model CompanyTeamEmployee {
  teamId     Int         @db.UnsignedInt
  team       CompanyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employeeId Int         @db.UnsignedInt
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([teamId, employeeId])
}

model CompanyInvitation {
  id             Int                     @id @default(autoincrement()) @db.UnsignedInt
  companyId      Int                     @db.UnsignedInt
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email          String
  roleId         Int                     @db.UnsignedInt
  role           CompanyRole             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  tokenHash      String                  @unique @db.Char(64)
  status         CompanyInvitationStatus @default(PENDING)
  scopeMode      DataScopeMode           @default(NONE)
  scopeJson      String?                 @db.Text
  moduleKeysJson String?                 @db.Text
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdById    Int                     @db.UnsignedInt
  createdBy      User                    @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime                @default(now())

  @@index([companyId, email, status])
}

model CompanyAccessAudit {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  companyId    Int      @db.UnsignedInt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorUserId  Int      @db.UnsignedInt
  actorUser    User     @relation("AccessAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  targetUserId Int?     @db.UnsignedInt
  targetUser   User?    @relation("AccessAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String   @db.VarChar(96)
  summary      String   @db.Text
  metadataJson String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([companyId, createdAt])
}

model Employee {
  id                          Int                          @id @default(autoincrement()) @db.UnsignedInt
  firstName                   String
  lastName                    String
  photoUrl                    String?
  registrationNumber          String?
  email                       String?                      @unique
  password                    String?
  department                  String
  branch                      String?
  managerName                 String?
  hireDate                    DateTime?
  terminationDate             DateTime?
  age                         Int
  rfidCardId                  String?                      @unique
  isActive                    Boolean                      @default(true)
  companyId                   Int                          @db.UnsignedInt
  company                     Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  logs                        AttendanceLog[]
  leaves                      LeaveRequest[]
  calendarAssignments         CalendarAssignment[]
  calendarSpecialDays         CalendarSpecialDay[]
  dailyExceptions             CalendarDailyException[]
  dailyCalendars              EmployeeDailyCalendar[]
  attendanceAudits            AttendanceMovementAudit[]
  attendanceReviewResolutions AttendanceReviewResolution[]
  branchId                    Int?                         @db.UnsignedInt
  branchRef                   Branch?                      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  departmentId                Int?                         @db.UnsignedInt
  departmentRef               Department?                  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  linkedMembership            CompanyMembership?
  explicitMembershipScopes    MembershipEmployeeScope[]    @relation("ExplicitEmployeeScope")
  teamMemberships             CompanyTeamEmployee[]
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  @@unique([companyId, registrationNumber])
}

model Department {
  id                  Int                         @id @default(autoincrement()) @db.UnsignedInt
  name                String
  isActive            Boolean                     @default(true)
  companyId           Int                         @db.UnsignedInt
  company             Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  calendarAssignments CalendarAssignment[]
  calendarSpecialDays CalendarSpecialDay[]
  dailyExceptions     CalendarDailyException[]
  employees           Employee[]
  membershipScopes    MembershipDepartmentScope[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@unique([companyId, name])
}

model Branch {
  id                  Int                      @id @default(autoincrement()) @db.UnsignedInt
  name                String
  location            String?
  isActive            Boolean                  @default(true)
  companyId           Int                      @db.UnsignedInt
  company             Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  calendarAssignments CalendarAssignment[]
  calendarSpecialDays CalendarSpecialDay[]
  dailyExceptions     CalendarDailyException[]
  employees           Employee[]
  membershipScopes    MembershipBranchScope[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([companyId, name])
}

model Manager {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  name      String
  email     String?
  isActive  Boolean  @default(true)
  companyId Int      @db.UnsignedInt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
}

model Device {
  id                   Int                     @id @default(autoincrement()) @db.UnsignedInt
  code                 String?
  name                 String
  macAddress           String?                 @unique
  ipAddress            String?
  branchLocation       String?
  purpose              DevicePurpose           @default(BIDIRECTIONAL)
  secretKey            String                  @default(uuid())
  lastSeenAt           DateTime?
  lastDataTransferAt   DateTime?
  clockOffsetMinutes   Int?
  firmwareVersion      String?
  lastFirmwareCheckAt  DateTime?
  lastFirmwareUpdateAt DateTime?
  firmwareLastError    String?                 @db.Text
  pendingQueueCount    Int?                    @db.UnsignedInt
  oldestQueuedAt       DateTime?
  clockSynchronized    Boolean?
  lastSendError        String?                 @db.Text
  healthReportedAt     DateTime?
  companyId            Int?                    @db.UnsignedInt
  company              Company?                @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userAccess           UserDeviceAccess[]
  logs                 AttendanceLog[]
  firmwareDeployments  FirmwareDeployment[]
  membershipScopes     MembershipDeviceScope[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([companyId, code])
}

model FirmwareRelease {
  id               Int                  @id @default(autoincrement()) @db.UnsignedInt
  version          String               @unique
  releaseNotes     String?              @db.Text
  originalFileName String
  storageKey       String               @unique
  sizeBytes        Int                  @db.UnsignedInt
  sha256           String               @db.Char(64)
  isActive         Boolean              @default(true)
  createdById      Int                  @db.UnsignedInt
  createdBy        User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  deployments      FirmwareDeployment[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model FirmwareDeployment {
  id                Int                      @id @default(autoincrement()) @db.UnsignedInt
  releaseId         Int                      @db.UnsignedInt
  release           FirmwareRelease          @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  deviceId          Int                      @db.UnsignedInt
  device            Device                   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  status            FirmwareDeploymentStatus @default(PENDING)
  downloadToken     String                   @unique @default(uuid())
  attemptCount      Int                      @default(0) @db.UnsignedInt
  lastError         String?                  @db.Text
  requestedAt       DateTime                 @default(now())
  downloadStartedAt DateTime?
  installedAt       DateTime?
  lastReportedAt    DateTime?
  createdById       Int                      @db.UnsignedInt
  createdBy         User                     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([deviceId, status, requestedAt])
  @@index([releaseId, status])
}

model UserDeviceAccess {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  userId    Int      @db.UnsignedInt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  Int      @db.UnsignedInt
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, deviceId])
}

model AttendanceLog {
  id            Int            @id @default(autoincrement()) @db.UnsignedInt
  employeeId    Int            @db.UnsignedInt
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  deviceId      Int?           @db.UnsignedInt
  device        Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  clientEventId String?        @db.VarChar(96)
  scannedAt     DateTime       @default(now())
  receivedAt    DateTime?
  type          AttendanceType
  rfidCardId    String?

  @@unique([deviceId, clientEventId])
}

model AttendanceReviewResolution {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  employeeId     Int      @db.UnsignedInt
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate       DateTime
  fingerprint    String   @db.VarChar(64)
  resolutionNote String   @db.Text
  resolvedById   Int      @db.UnsignedInt
  resolvedBy     User     @relation(fields: [resolvedById], references: [id], onDelete: Restrict)
  resolvedAt     DateTime @default(now())

  @@unique([employeeId, workDate, fingerprint])
  @@index([workDate, resolvedAt])
}

model AttendanceMovementAudit {
  id               Int                      @id @default(autoincrement()) @db.UnsignedInt
  sourceLogId      Int?                     @db.UnsignedInt
  employeeId       Int                      @db.UnsignedInt
  employee         Employee                 @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  movementDateTime DateTime
  oldType          AttendanceType?
  newType          AttendanceType?
  oldScannedAt     DateTime?
  newScannedAt     DateTime?
  operation        AttendanceAuditOperation
  changedById      Int                      @db.UnsignedInt
  changedBy        User                     @relation(fields: [changedById], references: [id], onDelete: Restrict)
  correctionReason String                   @db.Text
  createdAt        DateTime                 @default(now())

  @@index([employeeId, movementDateTime])
  @@index([sourceLogId])
  @@index([changedById, createdAt])
}

model LeaveRequest {
  id             Int                     @id @default(autoincrement()) @db.UnsignedInt
  employeeId     Int                     @db.UnsignedInt
  employee       Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId      Int                     @db.UnsignedInt
  type           LeaveType
  durationType   LeaveDurationType
  approvalStatus LeaveApprovalStatus     @default(PENDING)
  startDate      DateTime
  endDate        DateTime
  startTime      String?
  endTime        String?
  description    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  dailyCalendars EmployeeDailyCalendar[]
}

model WorkCalendarTemplate {
  id             Int                     @id @default(autoincrement()) @db.UnsignedInt
  code           String
  name           String
  description    String?
  validFrom      DateTime?
  validTo        DateTime?
  isDefault      Boolean                 @default(false)
  isActive       Boolean                 @default(true)
  companyId      Int                     @db.UnsignedInt
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  weekdays       WorkCalendarWeekday[]
  assignments    CalendarAssignment[]
  dailyCalendars EmployeeDailyCalendar[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([companyId, code])
}

model WorkCalendarWeekday {
  id                  Int                  @id @default(autoincrement()) @db.UnsignedInt
  calendarTemplateId  Int                  @db.UnsignedInt
  calendarTemplate    WorkCalendarTemplate @relation(fields: [calendarTemplateId], references: [id], onDelete: Cascade)
  weekday             Int
  dayType             WorkDayType          @default(NORMAL_WORK)
  startTime           String?
  endTime             String?
  breakStartTime      String?
  breakEndTime        String?
  crossesMidnight     Boolean              @default(false)
  breakMinutes        Int                  @default(0)
  plannedGrossMinutes Int                  @default(0)
  plannedNetMinutes   Int                  @default(0)
  checkLateArrival    Boolean              @default(true)
  checkEarlyDeparture Boolean              @default(true)
  checkAbsence        Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([calendarTemplateId, weekday])
}

model CalendarAssignment {
  id                 Int                  @id @default(autoincrement()) @db.UnsignedInt
  calendarTemplateId Int                  @db.UnsignedInt
  calendarTemplate   WorkCalendarTemplate @relation(fields: [calendarTemplateId], references: [id], onDelete: Cascade)
  scopeType          CalendarScopeType
  companyId          Int                  @db.UnsignedInt
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId           Int?                 @db.UnsignedInt
  branch             Branch?              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  departmentId       Int?                 @db.UnsignedInt
  department         Department?          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employeeId         Int?                 @db.UnsignedInt
  employee           Employee?            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  validFrom          DateTime
  validTo            DateTime?
  priority           Int                  @default(100)
  isActive           Boolean              @default(true)
  description        String?
  conflictApproved   Boolean              @default(false)
  conflictReason     String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model CalendarSpecialDay {
  id             Int               @id @default(autoincrement()) @db.UnsignedInt
  name           String
  specialDayType SpecialDayType
  dateFrom       DateTime
  dateTo         DateTime
  isHalfDay      Boolean           @default(false)
  startTime      String?
  endTime        String?
  breakMinutes   Int               @default(0)
  scopeType      CalendarScopeType @default(COMPANY)
  companyId      Int               @db.UnsignedInt
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId       Int?              @db.UnsignedInt
  branch         Branch?           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  departmentId   Int?              @db.UnsignedInt
  department     Department?       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employeeId     Int?              @db.UnsignedInt
  employee       Employee?         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  description    String?
  repeatsYearly  Boolean           @default(false)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model CalendarDailyException {
  id              Int                    @id @default(autoincrement()) @db.UnsignedInt
  workDate        DateTime
  scopeType       CalendarScopeType
  companyId       Int                    @db.UnsignedInt
  company         Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        Int?                   @db.UnsignedInt
  branch          Branch?                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  departmentId    Int?                   @db.UnsignedInt
  department      Department?            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employeeId      Int?                   @db.UnsignedInt
  employee        Employee?              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  originalDayType WorkDayType?
  newDayType      WorkDayType
  newStartTime    String?
  newEndTime      String?
  newBreakMinutes Int?
  changeReason    String
  approvalStatus  CalendarApprovalStatus @default(APPROVED)
  createdById     Int?                   @db.UnsignedInt
  approvedById    Int?                   @db.UnsignedInt
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model EmployeeDailyCalendar {
  id                  Int                       @id @default(autoincrement()) @db.UnsignedInt
  employeeId          Int                       @db.UnsignedInt
  employee            Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate            DateTime
  employmentStatus    EmploymentStatus
  dayType             WorkDayType
  plannedStart        String?
  plannedEnd          String?
  plannedBreakStart   String?
  plannedBreakEnd     String?
  crossesMidnight     Boolean                   @default(false)
  plannedBreakMinutes Int                       @default(0)
  plannedGrossMinutes Int                       @default(0)
  plannedNetMinutes   Int                       @default(0)
  checkLateArrival    Boolean                   @default(false)
  checkEarlyDeparture Boolean                   @default(false)
  checkAbsence        Boolean                   @default(false)
  leaveId             Int?                      @db.UnsignedInt
  leave               LeaveRequest?             @relation(fields: [leaveId], references: [id], onDelete: SetNull)
  calendarTemplateId  Int?                      @db.UnsignedInt
  calendarTemplate    WorkCalendarTemplate?     @relation(fields: [calendarTemplateId], references: [id], onDelete: SetNull)
  ruleSourceType      String
  ruleSourceId        Int?                      @db.UnsignedInt
  calculationStatus   CalendarCalculationStatus @default(CALCULATED)
  calculationReason   String
  calculatedAt        DateTime                  @default(now())

  @@unique([employeeId, workDate])
}

model CalendarChangeLog {
  id           Int                @id @default(autoincrement()) @db.UnsignedInt
  companyId    Int?               @db.UnsignedInt
  recordType   CalendarRecordType
  recordId     Int                @db.UnsignedInt
  oldValue     String?            @db.Text
  newValue     String?            @db.Text
  changeReason String?            @db.Text
  changedById  Int?               @db.UnsignedInt
  approvedById Int?               @db.UnsignedInt
  changedAt    DateTime           @default(now())
}

model PayrollPeriod {
  id                Int                 @id @default(autoincrement()) @db.UnsignedInt
  companyId         Int                 @db.UnsignedInt
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year              Int                 @db.UnsignedSmallInt
  month             Int                 @db.UnsignedTinyInt
  status            PayrollPeriodStatus @default(OPEN)
  snapshotJson      String?             @db.LongText
  snapshotCreatedAt DateTime?
  approvalNote      String?             @db.Text
  approvedById      Int?                @db.UnsignedInt
  approvedBy        User?               @relation("PayrollApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  lockedById        Int?                @db.UnsignedInt
  lockedBy          User?               @relation("PayrollLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  lockedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([companyId, year, month])
  @@index([status, year, month])
}
