  stockQuantity    Int?
  dispatchDuration Int                    @default(1)
  status           CommerceProductStatus  @default(DRAFT)
  shopierProductId String?                @unique @db.VarChar(64)
  shopierUrl       String?                @db.VarChar(500)
  publishedAt      DateTime?
  publishError     String?                @db.VarChar(500)
