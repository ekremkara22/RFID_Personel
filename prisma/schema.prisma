generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPERADMIN
  COMPANY_ADMIN
  EMPLOYEE
}

enum AttendanceType {
  ENTRY
  EXIT
  BREAK_START
  BREAK_END
  MEAL_START
  MEAL_END
}

enum DevicePurpose {
  ENTRY
  EXIT
  BREAK_START
  BREAK_END
  BIDIRECTIONAL
}

enum LeaveType {
  ANNUAL
  EXCUSE
  UNPAID
  MEDICAL
  ADMINISTRATIVE
  HOURLY
  HALF_DAY
}

enum LeaveDurationType {
  FULL_DAY
  HALF_DAY
  HOURLY
}

enum LeaveApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Company {
  id            String   @id @default(uuid())
  name          String
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  address       String?
  city          String?
  district      String?
  category      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]
  employees     Employee[]
  devices       Device[]
  departments   Department[]
  branches      Branch[]
  managers      Manager[]
}

model CompanyCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  firstName String?
  lastName  String?
  tcNo      String?
  role      Role     @default(COMPANY_ADMIN)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id                String          @id @default(uuid())
  firstName         String
  lastName          String
  photoUrl          String?
  registrationNumber String?
  email             String?         @unique
  password          String?
  department        String
  branch            String?
  managerName       String?
  hireDate          DateTime?
  terminationDate   DateTime?
  age               Int
  rfidCardId        String?         @unique
  isActive          Boolean         @default(true)
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  logs              AttendanceLog[]
  leaves            LeaveRequest[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([companyId, registrationNumber])
}

model Department {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  location  String?
  isActive  Boolean  @default(true)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
}

model Manager {
  id        String   @id @default(uuid())
  name      String
  email     String?
  isActive  Boolean  @default(true)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
}

model Device {
  id              String          @id @default(uuid())
  code            String?
  name            String
  macAddress      String?         @unique
  ipAddress       String?
  branchLocation  String?
  purpose         DevicePurpose   @default(BIDIRECTIONAL)
  secretKey       String          @default(uuid())
  lastSeenAt      DateTime?
  lastDataTransferAt DateTime?
  clockOffsetMinutes Int?
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  logs            AttendanceLog[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([companyId, code])
}

model AttendanceLog {
  id                String         @id @default(uuid())
  employeeId        String
  employee          Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  deviceId          String?
  device            Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  scannedAt         DateTime       @default(now())
  type              AttendanceType
  rfidCardId        String?
}

model LeaveRequest {
  id             String              @id @default(uuid())
  employeeId     String
  employee       Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId      String
  type           LeaveType
  durationType   LeaveDurationType
  approvalStatus LeaveApprovalStatus @default(PENDING)
  startDate      DateTime
  endDate        DateTime
  startTime      String?
  endTime        String?
  description    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}
