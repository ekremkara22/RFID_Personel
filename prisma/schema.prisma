/// sourceUrl is set for images imported from Shopier that were not downloaded.
model CommerceProductImage {
  id         Int             @id @default(autoincrement()) @db.UnsignedInt
  productId  Int             @db.UnsignedInt
  product    CommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey String?         @db.VarChar(80)
  sourceUrl  String?         @db.VarChar(500)
  placement  Int
  createdAt  DateTime        @default(now())

  @@index([productId, placement])
}

/// One license activation per order + Shopier product (idempotency key).
model ShopierOrderLicense {
  id               Int                  @id @default(autoincrement()) @db.UnsignedInt
  orderId          Int                  @db.UnsignedInt
  order            ShopierOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopierProductId String               @db.VarChar(64)
  moduleKey        String               @db.VarChar(64)
  durationDays     Int?
  quantity         Int                  @default(1)
  status           ShopierLicenseStatus
  userId           Int?                 @db.UnsignedInt
  user             User?                @relation("ShopierLicenseHolder", fields: [userId], references: [id], onDelete: SetNull)
  activatedAt      DateTime?
  activatedById    Int?                 @db.UnsignedInt
  activatedBy      User?                @relation("ShopierLicenseActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)
  expiresAtAfter   DateTime?
  note             String?              @db.VarChar(500)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([orderId, shopierProductId])
  @@index([status])
  @@index([userId])
  @@index([activatedById])
}
