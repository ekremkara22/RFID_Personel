generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPERADMIN
  COMPANY_ADMIN
  EMPLOYEE
}

enum AttendanceType {
  ENTRY
  EXIT
  BREAK_START
  BREAK_END
  MEAL_START
  MEAL_END
  INTERMEDIATE
}

enum AttendanceTrackingMode {
  BREAK_TRACKING
  ENTRY_EXIT_ONLY
}

enum BreakDeductionMode {
  PLANNED
  PLANNED_AND_EXCESS
}

enum AttendanceAuditOperation {
  INSERT
  UPDATE
  DELETE
}

enum PayrollPeriodStatus {
  OPEN
  APPROVED
  LOCKED
}

enum DevicePurpose {
  ENTRY
  EXIT
  BREAK_START
  BREAK_END
  BIDIRECTIONAL
}

enum FirmwareDeploymentStatus {
  PENDING
  DOWNLOADING
  INSTALLED
  FAILED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  EXCUSE
  UNPAID
  MEDICAL
  ADMINISTRATIVE
  HOURLY
  HALF_DAY
}

enum LeaveDurationType {
  FULL_DAY
  HALF_DAY
  HOURLY
}

enum LeaveApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkDayType {
  NORMAL_WORK
  WEEKLY_REST
  NON_WORKING
  OFFICIAL_HOLIDAY
  COMPANY_HOLIDAY
  HALF_WORK
  EXTRA_WORK
  SPECIAL_WORK
  LEAVE
  CONFLICT
}

enum CalendarScopeType {
  COMPANY
  BRANCH
  DEPARTMENT
  EMPLOYEE
}

enum SpecialDayType {
  OFFICIAL_HOLIDAY
  COMPANY_HOLIDAY
  ADMINISTRATIVE_HOLIDAY
  HALF_WORK
  EXTRA_WORK
  DEPARTMENT_HOLIDAY
  DEPARTMENT_WORK
  BRANCH_HOLIDAY
  BRANCH_WORK
}

enum CalendarCalculationStatus {
  CALCULATED
  CONFLICT
  MISSING_DEFAULT
  OUT_OF_EMPLOYMENT
}

enum EmploymentStatus {
  ACTIVE
  PASSIVE
  BEFORE_HIRE
  AFTER_TERMINATION
}

enum CalendarRecordType {
  TEMPLATE
  WEEKDAY
  ASSIGNMENT
  SPECIAL_DAY
  DAILY_EXCEPTION
  EMPLOYEE_DAILY_CALENDAR
}

enum CalendarApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CompanyMembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum DataScopeMode {
  COMPANY
  RESTRICTED
  OWN
  NONE
}

enum CompanyInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SalaryInsuranceType {
  INCENTIVE
  NO_INCENTIVE
  RETIRED
}

enum SalaryBasis {
  GROSS
  NET
}

enum SalaryWorksheetMode {
  GROSS_TO_NET
  NET_TO_GROSS
}

enum ShopierLicenseStatus {
  PENDING_MATCH
  ACTIVATED
  REFUNDED
  IGNORED
}

enum CommerceProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductionStationType {
  GENERAL
  INJECTION
  CNC_TURNING
  CNC_MILLING
  ASSEMBLY
  QUALITY
}

enum ProductionWorkOrderStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductionCustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

model Company {
  id                                 Int                        @id @default(autoincrement()) @db.UnsignedInt
  name                               String
  contactName                        String?
  contactEmail                       String?
  contactPhone                       String?
  address                            String?
  city                               String?
  district                           String?
  category                           String?
  isActive                           Boolean                    @default(true)
  attendanceFinalizationDelayMinutes Int                        @default(120)
  attendanceTrackingMode             AttendanceTrackingMode     @default(BREAK_TRACKING)
  breakDeductionMode                 BreakDeductionMode         @default(PLANNED_AND_EXCESS)
  createdAt                          DateTime                   @default(now())
  updatedAt                          DateTime                   @updatedAt
  users                              User[]
  userAccess                         UserCompanyAccess[]
  employees                          Employee[]
  devices                            Device[]
  departments                        Department[]
  branches                           Branch[]
  managers                           Manager[]
  calendarTemplates                  WorkCalendarTemplate[]
  calendarAssignments                CalendarAssignment[]
  calendarSpecialDays                CalendarSpecialDay[]
  dailyExceptions                    CalendarDailyException[]
  payrollPeriods                     PayrollPeriod[]
  companyRoles                       CompanyRole[]
  memberships                        CompanyMembership[]
  invitations                        CompanyInvitation[]
  accessAudits                       CompanyAccessAudit[]
  teams                              CompanyTeam[]
  productionWorkCenters              ProductionWorkCenter[]
  productionStations                 ProductionStation[]
  productionTools                    ProductionTool[]
  productionCycleTimes               ProductionCycleTime[]
  productionWorkOrders               ProductionWorkOrder[]
  productionCustomFields             ProductionCustomField[]
  productionImportTemplates          ProductionImportTemplate[]
  accountingDepartments              AccountingDepartment[]
  accountingPositions                AccountingPosition[]
  accountingCollarTypes              AccountingCollarType[]
  accountingPersonnel                AccountingPersonnel[]
  salaryWorksheetRows                SalaryWorksheetRow[]
  salaryParameterSet                 SalaryParameterSet?
}

model CompanyCategory {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoleDefinition {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  code        Role     @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ModuleDefinition {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  key         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  purchaseUrl String?  @db.VarChar(500)
  priceLabel  String?  @db.VarChar(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                          Int                          @id @default(autoincrement()) @db.UnsignedInt
  username                    String?                      @unique @db.VarChar(64)
  email                       String                       @unique
  phone                       String?                      @db.VarChar(32)
  password                    String
  name                        String?
  firstName                   String?
  lastName                    String?
  tcNo                        String?
  role                        Role                         @default(COMPANY_ADMIN)
  companyId                   Int?                         @db.UnsignedInt
  company                     Company?                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  selfRegistered              Boolean                      @default(false)
  trialEndsAt                 DateTime?
  emailVerifiedAt             DateTime?
  emailTokens                 UserEmailToken[]
  companyAccess               UserCompanyAccess[]
  deviceAccess                UserDeviceAccess[]
  attendanceAudits            AttendanceMovementAudit[]
  firmwareReleases            FirmwareRelease[]
  firmwareDeployments         FirmwareDeployment[]
  attendanceReviewResolutions AttendanceReviewResolution[]
  approvedPayrollPeriods      PayrollPeriod[]              @relation("PayrollApprovedBy")
  lockedPayrollPeriods        PayrollPeriod[]              @relation("PayrollLockedBy")
  memberships                 CompanyMembership[]
  moduleEntitlements          UserModuleEntitlement[]
  sentCompanyInvitations      CompanyInvitation[]          @relation("InvitationCreatedBy")
  accessAuditActions          CompanyAccessAudit[]         @relation("AccessAuditActor")
  accessAuditTargets          CompanyAccessAudit[]         @relation("AccessAuditTarget")
  updatedIntegrationCredentials IntegrationCredential[]    @relation("IntegrationCredentialUpdatedBy")
  shopierLicenses             ShopierOrderLicense[]        @relation("ShopierLicenseHolder")
  activatedShopierLicenses    ShopierOrderLicense[]        @relation("ShopierLicenseActivatedBy")
  fulfilledShopierOrders      ShopierOrder[]               @relation("ShopierOrderFulfilledBy")
  smartHomeGateways           SmartHomeGateway[]           @relation("SmartHomeGatewayOwner")
  smartHomeCommands           SmartHomeCommand[]           @relation("SmartHomeCommandRequester")
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
}

enum UserEmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Single-use e-mail links (verification, password reset); only the SHA-256 hash is stored.
model UserEmailToken {
  id        Int                     @id @default(autoincrement()) @db.UnsignedInt
  userId    Int                     @db.UnsignedInt
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   UserEmailTokenPurpose
  tokenHash String                  @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                @default(now())

  @@index([userId, purpose])
}

model UserModuleEntitlement {
  userId    Int      @db.UnsignedInt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleKey String    @db.VarChar(64)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@id([userId, moduleKey])
  @@index([moduleKey])
}

model UserCompanyAccess {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  userId    Int      @db.UnsignedInt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId Int      @db.UnsignedInt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
}

model CompanyRole {
  id          Int                     @id @default(autoincrement()) @db.UnsignedInt
  companyId   Int                     @db.UnsignedInt
  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key         String                  @db.VarChar(64)
  name        String
  description String?                 @db.Text
  isSystem    Boolean                 @default(false)
  isActive    Boolean                 @default(true)
  permissions CompanyRolePermission[]
  modules     CompanyRoleModule[]
  memberships CompanyMembership[]
  invitations CompanyInvitation[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([companyId, key])
}

model CompanyRoleModule {
  id        Int         @id @default(autoincrement()) @db.UnsignedInt
  roleId    Int         @db.UnsignedInt
  role      CompanyRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  moduleKey String      @db.VarChar(64)
  createdAt DateTime    @default(now())

  @@unique([roleId, moduleKey])
  @@index([moduleKey])
}

model CompanyRolePermission {
  id         Int         @id @default(autoincrement()) @db.UnsignedInt
  roleId     Int         @db.UnsignedInt
  role       CompanyRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String      @db.VarChar(96)

  @@unique([roleId, permission])
}

model CompanyMembership {
  id               Int                         @id @default(autoincrement()) @db.UnsignedInt
  userId           Int                         @db.UnsignedInt
  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId        Int                         @db.UnsignedInt
  company          Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleId           Int                         @db.UnsignedInt
  role             CompanyRole                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  employeeId       Int?                        @unique @db.UnsignedInt
  employee         Employee?                   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  status           CompanyMembershipStatus     @default(PENDING)
  scopeMode        DataScopeMode               @default(NONE)
  sessionVersion   Int                         @default(1) @db.UnsignedInt
  branchScopes     MembershipBranchScope[]
  departmentScopes MembershipDepartmentScope[]
  employeeScopes   MembershipEmployeeScope[]
  deviceScopes     MembershipDeviceScope[]
  teamScopes       MembershipTeamScope[]
  modules          MembershipModule[]
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@unique([userId, companyId])
  @@index([companyId, status])
}

model MembershipModule {
  membershipId Int               @db.UnsignedInt
  membership   CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  moduleKey    String            @db.VarChar(64)
  createdAt    DateTime          @default(now())

  @@id([membershipId, moduleKey])
  @@index([moduleKey])
}

model MembershipBranchScope {
  membershipId Int               @db.UnsignedInt
  membership   CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branchId     Int               @db.UnsignedInt
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([membershipId, branchId])
}

model MembershipDepartmentScope {
  membershipId Int               @db.UnsignedInt
  membership   CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  departmentId Int               @db.UnsignedInt
  department   Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([membershipId, departmentId])
}

model MembershipEmployeeScope {
  membershipId Int               @db.UnsignedInt
  membership   CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  employeeId   Int               @db.UnsignedInt
  employee     Employee          @relation("ExplicitEmployeeScope", fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([membershipId, employeeId])
}

model MembershipDeviceScope {
  membershipId Int               @db.UnsignedInt
  membership   CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  deviceId     Int               @db.UnsignedInt
  device       Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([membershipId, deviceId])
}

model MembershipTeamScope {
  membershipId Int               @db.UnsignedInt
  membership   CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  teamId       Int               @db.UnsignedInt
  team         CompanyTeam       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([membershipId, teamId])
}

model CompanyTeam {
  id        Int                   @id @default(autoincrement()) @db.UnsignedInt
  companyId Int                   @db.UnsignedInt
  company   Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean               @default(true)
  members   CompanyTeamEmployee[]
  scopes    MembershipTeamScope[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([companyId, name])
}

model CompanyTeamEmployee {
  teamId     Int         @db.UnsignedInt
  team       CompanyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employeeId Int         @db.UnsignedInt
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([teamId, employeeId])
}

model CompanyInvitation {
  id             Int                     @id @default(autoincrement()) @db.UnsignedInt
  companyId      Int                     @db.UnsignedInt
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email          String
  roleId         Int                     @db.UnsignedInt
  role           CompanyRole             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  tokenHash      String                  @unique @db.Char(64)
  status         CompanyInvitationStatus @default(PENDING)
  scopeMode      DataScopeMode           @default(NONE)
  scopeJson      String?                 @db.Text
  moduleKeysJson String?                 @db.Text
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdById    Int                     @db.UnsignedInt
  createdBy      User                    @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime                @default(now())

  @@index([companyId, email, status])
}

model CompanyAccessAudit {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  companyId    Int      @db.UnsignedInt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorUserId  Int      @db.UnsignedInt
  actorUser    User     @relation("AccessAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  targetUserId Int?     @db.UnsignedInt
  targetUser   User?    @relation("AccessAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String   @db.VarChar(96)
  summary      String   @db.Text
  metadataJson String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([companyId, createdAt])
}

model Employee {
  id                          Int                          @id @default(autoincrement()) @db.UnsignedInt
  firstName                   String
  lastName                    String
  photoUrl                    String?
  registrationNumber          String?
  email                       String?                      @unique
  password                    String?
  department                  String
  branch                      String?
  managerName                 String?
  hireDate                    DateTime?
  terminationDate             DateTime?
  age                         Int
  rfidCardId                  String?                      @unique
  isActive                    Boolean                      @default(true)
  companyId                   Int                          @db.UnsignedInt
  company                     Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  logs                        AttendanceLog[]
  leaves                      LeaveRequest[]
  calendarAssignments         CalendarAssignment[]
  calendarSpecialDays         CalendarSpecialDay[]
  dailyExceptions             CalendarDailyException[]
  dailyCalendars              EmployeeDailyCalendar[]
  attendanceAudits            AttendanceMovementAudit[]
  attendanceReviewResolutions AttendanceReviewResolution[]
  branchId                    Int?                         @db.UnsignedInt
  branchRef                   Branch?                      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  departmentId                Int?                         @db.UnsignedInt
  departmentRef               Department?                  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  linkedMembership            CompanyMembership?
  explicitMembershipScopes    MembershipEmployeeScope[]    @relation("ExplicitEmployeeScope")
  teamMemberships             CompanyTeamEmployee[]
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  @@unique([companyId, registrationNumber])
}

model Department {
  id                  Int                         @id @default(autoincrement()) @db.UnsignedInt
  name                String
  isActive            Boolean                     @default(true)
  companyId           Int                         @db.UnsignedInt
  company             Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  calendarAssignments CalendarAssignment[]
  calendarSpecialDays CalendarSpecialDay[]
  dailyExceptions     CalendarDailyException[]
  employees           Employee[]
  membershipScopes    MembershipDepartmentScope[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@unique([companyId, name])
}

model Branch {
  id                  Int                      @id @default(autoincrement()) @db.UnsignedInt
  name                String
  location            String?
  isActive            Boolean                  @default(true)
  companyId           Int                      @db.UnsignedInt
  company             Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  calendarAssignments CalendarAssignment[]
  calendarSpecialDays CalendarSpecialDay[]
  dailyExceptions     CalendarDailyException[]
  employees           Employee[]
  membershipScopes    MembershipBranchScope[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([companyId, name])
}

model Manager {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  name      String
  email     String?
  isActive  Boolean  @default(true)
  companyId Int      @db.UnsignedInt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
}

model ProductionWorkCenter {
  id                 Int                   @id @default(autoincrement()) @db.UnsignedInt
  companyId          Int                   @db.UnsignedInt
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code               String                @db.VarChar(64)
  name               String                @db.VarChar(160)
  description        String?               @db.Text
  calendarTemplateId Int?                  @db.UnsignedInt
  calendarTemplate   WorkCalendarTemplate? @relation("ProductionWorkCenterCalendar", fields: [calendarTemplateId], references: [id], onDelete: SetNull)
  isActive           Boolean               @default(true)
  stations           ProductionStation[]
  workOrders         ProductionWorkOrder[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([companyId, code])
  @@index([companyId, isActive, name])
}

model ProductionStation {
  id                 Int                   @id @default(autoincrement()) @db.UnsignedInt
  companyId          Int                   @db.UnsignedInt
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workCenterId       Int                   @db.UnsignedInt
  workCenter         ProductionWorkCenter  @relation(fields: [workCenterId], references: [id], onDelete: Restrict)
  code               String                @db.VarChar(64)
  name               String                @db.VarChar(160)
  stationType        ProductionStationType @default(GENERAL)
  description        String?               @db.Text
  calendarTemplateId Int?                  @db.UnsignedInt
  calendarTemplate   WorkCalendarTemplate? @relation("ProductionStationCalendar", fields: [calendarTemplateId], references: [id], onDelete: SetNull)
  isActive           Boolean               @default(true)
  cycleTimes         ProductionCycleTime[]
  workOrders         ProductionWorkOrder[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([companyId, code])
  @@index([companyId, workCenterId, isActive])
}

model ProductionTool {
  id          Int                   @id @default(autoincrement()) @db.UnsignedInt
  companyId   Int                   @db.UnsignedInt
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        String                @db.VarChar(64)
  name        String                @db.VarChar(160)
  toolType    String?               @db.VarChar(80)
  description String?               @db.Text
  isActive    Boolean               @default(true)
  cycleTimes  ProductionCycleTime[]
  workOrders  ProductionWorkOrder[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([companyId, code])
  @@index([companyId, isActive, name])
}

model ProductionCycleTime {
  id                   Int                   @id @default(autoincrement()) @db.UnsignedInt
  companyId            Int                   @db.UnsignedInt
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stationId            Int                   @db.UnsignedInt
  station              ProductionStation     @relation(fields: [stationId], references: [id], onDelete: Restrict)
  toolId               Int?                  @db.UnsignedInt
  tool                 ProductionTool?       @relation(fields: [toolId], references: [id], onDelete: SetNull)
  itemCode             String                @db.VarChar(96)
  itemName             String?               @db.VarChar(255)
  cycleSeconds         Int                   @db.UnsignedInt
  cavityCount          Int                   @default(1) @db.UnsignedSmallInt
  setupMinutes         Int                   @default(0) @db.UnsignedInt
  validFrom            DateTime?
  validTo              DateTime?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  productionWorkOrders ProductionWorkOrder[]

  @@index([companyId, stationId, itemCode, isActive])
  @@index([companyId, toolId])
}

model ProductionCustomField {
  id           Int                       @id @default(autoincrement()) @db.UnsignedInt
  companyId    Int                       @db.UnsignedInt
  company      Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entity       String                    @default("WORK_ORDER") @db.VarChar(64)
  fieldKey     String                    @db.VarChar(64)
  label        String                    @db.VarChar(160)
  fieldType    ProductionCustomFieldType @default(TEXT)
  optionsJson  String?                   @db.Text
  isRequired   Boolean                   @default(false)
  displayOrder Int                       @default(0)
  isActive     Boolean                   @default(true)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([companyId, entity, fieldKey])
  @@index([companyId, entity, isActive, displayOrder])
}

model ProductionImportTemplate {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  companyId   Int      @db.UnsignedInt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entity      String   @default("WORK_ORDER") @db.VarChar(64)
  name        String   @db.VarChar(160)
  columnsJson String   @db.LongText
  mappingJson String?  @db.LongText
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, entity, name])
}

model ProductionWorkOrder {
  id                   Int                       @id @default(autoincrement()) @db.UnsignedInt
  companyId            Int                       @db.UnsignedInt
  company              Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrderNo          String                    @db.VarChar(96)
  orderNo              String?                   @db.VarChar(96)
  itemCode             String                    @db.VarChar(96)
  itemName             String?                   @db.VarChar(255)
  quantity             Decimal                   @db.Decimal(14, 3)
  workCenterId         Int                       @db.UnsignedInt
  workCenter           ProductionWorkCenter      @relation(fields: [workCenterId], references: [id], onDelete: Restrict)
  stationId            Int                       @db.UnsignedInt
  station              ProductionStation         @relation(fields: [stationId], references: [id], onDelete: Restrict)
  toolId               Int?                      @db.UnsignedInt
  tool                 ProductionTool?           @relation(fields: [toolId], references: [id], onDelete: SetNull)
  cycleTimeId          Int?                      @db.UnsignedInt
  cycleTime            ProductionCycleTime?      @relation(fields: [cycleTimeId], references: [id], onDelete: SetNull)
  cycleSecondsSnapshot Int                       @db.UnsignedInt
  cavityCountSnapshot  Int                       @default(1) @db.UnsignedSmallInt
  setupMinutesSnapshot Int                       @default(0) @db.UnsignedInt
