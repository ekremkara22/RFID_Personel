/// Physical product managed in the panel and published to Shopier (panel is the source of truth).
/// No variants in Faz 2: one price, one stock per product.
model CommerceProduct {
  id               Int                    @id @default(autoincrement()) @db.UnsignedInt
  title            String                 @db.VarChar(200)
  description      String?                @db.Text
  price            Decimal                @db.Decimal(12, 2)
  currency         String                 @default("TRY") @db.VarChar(3)
  vatPercent       Int?
  shippingPayer    String                 @default("buyerPays") @db.VarChar(16)
