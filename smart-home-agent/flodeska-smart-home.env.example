FLODESKA_SMART_HOME_URL=https://test.flodeska.com
FLODESKA_SMART_HOME_API_KEY=CHANGE_ME
# Kök ESP32'nin USB seri portu. ESP32 olmadan denemek için: simulate, hiç kullanmamak için: none
FLODESKA_SERIAL_PORT=simulate
FLODESKA_SERIAL_BAUD=115200
# Uzaktan açılacak bilgisayarlar: Ad|MAC|IP, birden fazlası ";" ile ayrılır. Boş bırakılabilir.
FLODESKA_WOL_TARGETS=
