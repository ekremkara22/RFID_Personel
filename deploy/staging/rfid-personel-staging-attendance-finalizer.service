[Unit]
Description=RFID Personel staging attendance finalizer
After=network.target mariadb.service
Requires=mariadb.service

[Service]
Type=oneshot
WorkingDirectory=/var/www/rfid-personel-staging
EnvironmentFile=/var/www/rfid-personel-staging/.env
ExecStart=/usr/bin/npm run attendance:finalize
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
