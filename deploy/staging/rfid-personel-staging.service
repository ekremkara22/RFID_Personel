[Unit]
Description=RFID Personel Takip staging Next.js app
After=network.target mariadb.service
Requires=mariadb.service

[Service]
Type=simple
WorkingDirectory=/var/www/rfid-personel-staging
EnvironmentFile=/var/www/rfid-personel-staging/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
