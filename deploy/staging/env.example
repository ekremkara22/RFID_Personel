JWT_SECRET="CHANGE_ME"
NODE_ENV="production"
APP_ENV="staging"
PORT="3003"
HOSTNAME="127.0.0.1"
FIRMWARE_STORAGE_DIR="/var/lib/rfid-personel-staging/firmware"
# Satış & Pazarlama: public https origin (Shopier webhook + product image URLs) and product image folder.
APP_URL="https://test.flodeska.com"
COMMERCE_MEDIA_DIR="/var/lib/rfid-personel-staging/commerce-products"
INTEGRATION_ENCRYPTION_KEY="CHANGE_ME_openssl_rand_base64_32"

# Otomatik sistem e-postaları. SMTP parolasını yalnız sunucudaki gerçek .env dosyasına yazın.
SMTP_HOST="mail.guzel.net.tr"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="report@flodeska.com"
SMTP_PASSWORD="CHANGE_ME"
MAIL_FROM_NAME="Flodeska"
